# Copy this file to .env and fill in your keys.
# Both are free to obtain:
#   Gemini:  https://aistudio.google.com/apikey   (free tier)
#   Tavily:  https://app.tavily.com                (free tier, ~1000 searches/month)
#
# Neither is *required* - BSE + Screener sources work with no API key at
# all. Without these, the tool falls back to keyword-heuristic
# classification and skips the web-search gap-filling stage.

GEMINI_API_KEY=
TAVILY_API_KEY=

# Optional overrides - sensible defaults are already set in config.py
# GEMINI_MODEL=gemini-2.5-flash
# OUTPUT_DIR=downloads
# DISABLE_LLM=0
