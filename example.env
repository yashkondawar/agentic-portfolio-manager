# .env

# DATA SOURCE CONFIGURATION
# Set to "true" to use free scraper (yfinance + screener.in) instead of Bright Data
# Set to "false" to use Bright Data MCP (requires BRIGHT_DATA_API_TOKEN)
USE_FREE_SCRAPER=true

# BRIGHT DATA (only needed if USE_FREE_SCRAPER=false)
BRIGHT_DATA_API_TOKEN=
API_TOKEN=

# GITHUB COPILOT SDK
# Uses the authenticated Copilot CLI user; no model API key is required.
COPILOT_MODEL=claude-opus-4.7
COPILOT_TIMEOUT=300
# Optional path to an executable Copilot CLI runtime. The SDK discovers the
# installed CLI automatically on Windows and downloads its runtime elsewhere.
# COPILOT_CLI_PATH=C:\Path\To\copilot.exe

# SYSTEM SETTINGS
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2.0
ENABLE_CACHING=true
LOG_LEVEL=INFO

# ZERODHA KITE CONNECT (for live trading)
# Get API key/secret from https://developers.kite.trade/
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# Callback port for auto-login (default 5678)
ZERODHA_CALLBACK_PORT=5678
# Optional: paste request_token for manual auth (changes daily)
ZERODHA_REQUEST_TOKEN=

# AGENT TIMEOUTS (seconds)
STOCK_FINDER_TIMEOUT=120
MARKET_DATA_TIMEOUT=180
NEWS_ANALYST_TIMEOUT=180
RECOMMENDATION_TIMEOUT=120

# GITHUB COPILOT CLI
# The CLI and SDK use your existing Copilot login. These are optional:
# COPILOT_BIN=C:\Path\To\copilot.cmd        # absolute path if not on PATH

# Prompt template used by portfolio_copilot_analysis.py
#   forensic = exhaustive 10-part institutional review (default)
#   concise  = 5-section restructuring brief (original)
PROMPT_TEMPLATE=forensic

# Web grounding: true (default) forces every Copilot CLI run to use its
# web-fetch / search tools to back findings with live prices, news, and
# filings, and starts the CLI with --allow-all-urls so URL approval
# prompts don't block the run. Set to false to fall back to model
# knowledge only.
WEB_GROUNDING=true

# Scraper tools: true (default) attaches the local stdio MCP server
# `mcp_server.py` via --additional-mcp-config, exposing Indian-equity
# scraper tools (screener.in fundamentals, yfinance ratios, technical
# indicators, news) directly to the model. Set to false to disable.
SCRAPER_TOOLS=true

# Investor context for the forensic template (all optional; CLI flags
# --cash / --horizon-years / --monthly-sip / --target-cagr /
# --risk-appetite override these).
# PORTFOLIO_CASH=50000
PORTFOLIO_HORIZON_YEARS=10
PORTFOLIO_MONTHLY_SIP=25000
PORTFOLIO_TARGET_CAGR=20
PORTFOLIO_RISK_APPETITE=Moderate

# KRONOS PRICE FORECAST (optional add-on; see kronos/README.md)
# Kronos is NOT on PyPI: clone https://github.com/shiyu-coder/Kronos and set
# KRONOS_REPO_PATH so 'from model import Kronos' resolves. Install deps with
# `uv pip install -e ".[kronos]"` (CPU torch build — no GPU needed).
# KRONOS_REPO_PATH=C:\tools\Kronos
# KRONOS_MODEL=NeoQuasar/Kronos-small
# KRONOS_DEVICE=cpu
# KRONOS_LOOKBACK=400
# KRONOS_PRED_LEN=10
# KRONOS_SAMPLE_PATHS=20
