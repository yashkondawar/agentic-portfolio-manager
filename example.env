# .env

# DATA SOURCE CONFIGURATION
# Set to "true" to use free scraper (yfinance + screener.in) instead of Bright Data
# Set to "false" to use Bright Data MCP (requires BRIGHT_DATA_API_TOKEN)
USE_FREE_SCRAPER=true

# BRIGHT DATA (only needed if USE_FREE_SCRAPER=false)
BRIGHT_DATA_API_TOKEN=
API_TOKEN=

# ══════════════════════════════════════════════════════════════════════════
# AGENT BACKEND — which harness runs the research agents.
# Pick ONE of the three setups below. Full rationale: docs/multi-provider-plan.md
# ══════════════════════════════════════════════════════════════════════════
#
# ── Option 1: GitHub Copilot CLI (default) ────────────────────────────────
# Needs: a Copilot subscription + `npm install -g @github/copilot`,
#        then `pip install -e ".[copilot]"`.
AI_AGENT_BACKEND=copilot_cli
COPILOT_MODEL=claude-opus-4.7
COPILOT_TIMEOUT=300
# Optional absolute path if `copilot` is not on PATH:
# COPILOT_BIN=C:\Path\To\copilot.cmd
# Optional path to an executable Copilot CLI runtime. The SDK discovers the
# installed CLI automatically on Windows and downloads its runtime elsewhere.
# COPILOT_CLI_PATH=C:\Path\To\copilot.exe
#
# ── Option 2: any LLM API key, no CLI and no subscription ─────────────────
# Needs: only `pip install -e ".[gemini]"` (or [openai] / [anthropic]).
# This is the path if you have nothing but an API key, and the only backend
# that runs in a container or in CI.
#
#   AI_AGENT_BACKEND=native
#
# Setting one API key below is enough - the model is inferred from it.
# AI_MODEL only needs setting to override that inference, or for Ollama:
#
#   AI_MODEL=google_genai:gemini-2.5-pro      # inferred from GOOGLE_API_KEY
#   AI_MODEL=openai:gpt-4o                    # inferred from OPENAI_API_KEY
#   AI_MODEL=anthropic:claude-sonnet-4-5      # inferred from ANTHROPIC_API_KEY
#   AI_MODEL=ollama:llama3.1                  # fully local, no key at all
#
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
#
# ── Option 3: a Claude Pro/Max subscription, no API key ───────────────────
# Needs: `npm install -g @anthropic-ai/claude-code` + `pip install -e ".[claude]"`.
# This is the only backend that accepts a *subscription* rather than a key.
# A subscription and an API key are different products: option 2's
# ANTHROPIC_API_KEY will not work with your Pro/Max plan, and vice versa.
#
#   AI_AGENT_BACKEND=claude_code
#
# Authenticate once with `claude setup-token`, which prints an sk-ant-oat...
# token valid for about a year:
#
# CLAUDE_CODE_OAUTH_TOKEN=
#
# Optional. Left blank, your subscription chooses the model.
# CLAUDE_MODEL=claude-sonnet-4-5
#
# WARNING: ANTHROPIC_API_KEY silently OUTRANKS the token above in the Claude
# CLI - same output, but billed pay-as-you-go instead of to the subscription
# you already pay for. If both are set, this app withholds the key from the
# CLI and says so in the log. To bill the API key on purpose:
# CLAUDE_CODE_USE_API_KEY=1
#
# Safety valve on the tool-calling loop (default 25).
# AI_MAX_TURNS=25
#
# Analyst fan-out width. Defaults to 12 on copilot_cli (a seat is billed per
# seat, so concurrency is free), 4 on native (an API key is metered per
# minute - Gemini's free tier allows only a handful of requests) and 2 on
# claude_code (every call spawns a CLI process and draws on a small monthly
# credit pool). Raise it if you are on a paid API tier.
# AI_MAX_CONCURRENCY=4
#
# NOTE: the `native` backend has no built-in web browsing, so runs that set
# WEB_GROUNDING=true are rejected up front rather than silently returning an
# ungrounded report. The ten scraper MCP tools (live prices, fundamentals,
# news, scrape_url) still work — those are MCP and run on every backend.
# Set WEB_GROUNDING=false to use this backend.
#
# (Claude Pro/Max subscription is supported via AI_AGENT_BACKEND=claude_code — see the Option 3 block above.)

# SYSTEM SETTINGS
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2.0
ENABLE_CACHING=true
LOG_LEVEL=INFO
# Optional local SQLite location. Default on Windows:
# %LOCALAPPDATA%\AgenticPortfolioManager\portfolio.sqlite3
# PORTFOLIO_DB_PATH=C:\Users\you\AppData\Local\AgenticPortfolioManager\portfolio.sqlite3
# Persistent live scrape entries expire after this many minutes.
SCRAPE_CACHE_TTL_MINUTES=15

# ZERODHA KITE CONNECT (for live trading)
# Get API key/secret from https://developers.kite.trade/
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# Callback port for auto-login (default 5678)
ZERODHA_CALLBACK_PORT=5678
# Optional: paste request_token for manual auth (changes daily)
ZERODHA_REQUEST_TOKEN=

# AGENT TIMEOUTS (seconds)
STOCK_FINDER_TIMEOUT=120
MARKET_DATA_TIMEOUT=180
NEWS_ANALYST_TIMEOUT=180
RECOMMENDATION_TIMEOUT=120

# GITHUB COPILOT CLI
# (backend settings are in the AGENT BACKEND block near the top of this file)

# Prompt template used by portfolio_copilot_analysis.py
#   forensic = exhaustive 10-part institutional review (default)
#   concise  = 5-section restructuring brief (original)
PROMPT_TEMPLATE=forensic

# Web grounding: true (default) forces every Copilot CLI run to use its
# web-fetch / search tools to back findings with live prices, news, and
# filings, and starts the CLI with --allow-all-urls so URL approval
# prompts don't block the run. Set to false to fall back to model
# knowledge only.
WEB_GROUNDING=true

# Scraper tools: true (default) attaches the local stdio MCP server
# `mcp_server.py` via --additional-mcp-config, exposing Indian-equity
# scraper tools (screener.in fundamentals, yfinance ratios, technical
# indicators, news) directly to the model. Set to false to disable.
SCRAPER_TOOLS=true

# Investor context for the forensic template (all optional; CLI flags
# --cash / --horizon-years / --monthly-sip / --target-cagr /
# --risk-appetite override these).
# PORTFOLIO_CASH=50000
PORTFOLIO_HORIZON_YEARS=10
PORTFOLIO_MONTHLY_SIP=25000
PORTFOLIO_TARGET_CAGR=20
PORTFOLIO_RISK_APPETITE=Moderate

# KRONOS PRICE FORECAST (optional add-on; see kronos/README.md)
# Kronos is NOT on PyPI: clone https://github.com/shiyu-coder/Kronos and set
# KRONOS_REPO_PATH so 'from model import Kronos' resolves. Install deps with
# `uv pip install -e ".[kronos]"` (CPU torch build — no GPU needed).
# KRONOS_REPO_PATH=C:\tools\Kronos
# KRONOS_MODEL=NeoQuasar/Kronos-small
# KRONOS_DEVICE=cpu
# KRONOS_LOOKBACK=400
# KRONOS_PRED_LEN=10
# KRONOS_SAMPLE_PATHS=20
